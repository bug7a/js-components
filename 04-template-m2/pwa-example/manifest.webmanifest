{
    "name": "App Example",
    "short_name": "App Example",
    "description": "A basic.js progressive web app skeleton with a fixed content width.",
    "id": "./index.htm",
    "start_url": "./index.htm",
    "scope": "./",
    "display": "standalone",
    "display_override": ["standalone", "minimal-ui", "browser"],
    "orientation": "portrait",
    "background_color": "#141414",
    "theme_color": "#141414",
    "lang": "en",
    "dir": "ltr",
    "icons": [
        {
            "src": "icon/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icon/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icon/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ]
}
